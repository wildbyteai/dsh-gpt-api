{
  "name": "dsh-gpt-api",
  "version": "1.2.0",
  "description": "GPT API：在对话中调用 GPT、文生图和参考图生图，支持自定义 OpenAI 兼容接口。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "api.js", "models-route.js", "client.js", "cordis.patch.yml", "locale", "README.md", "README.en.md"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wildbyteai/dsh-gpt-api.git"
  },
  "homepage": "https://github.com/wildbyteai/dsh-gpt-api#readme",
  "bugs": {"url": "https://github.com/wildbyteai/dsh-gpt-api/issues"},
  "engines": {"node": ">=22", "dsh": ">=0.2.1-rc.5 <0.3.0"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-connection"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {"test": "node --test test/*.test.js"}
}
